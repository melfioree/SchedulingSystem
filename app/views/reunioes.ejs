<%- include('partials/topo', { titulo: 'Reuniões' }) %>

<% if (eSocio) { %>
  <h1 class="h3 saudacao">Olá, <%= usuario.nome %></h1>
<% } else { %>
  <%- include('partials/abasCliente', { ativa: 'reunioes' }) %>
<% } %>

<% if (msg) { %>
  <div class="alert alert-<%= msg.tipo %>" role="alert"><%= msg.texto %></div>
<% } %>

<% if (eSocio) { %>
  <ul class="nav nav-pills" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= aba === 'pendentes' ? 'active' : '' %>" type="button" role="tab"
              data-bs-toggle="pill" data-bs-target="#abaPendentes">
        Pedidos pendentes
        <% if (pendentes.length > 0) { %><span class="badge text-bg-warning ms-1"><%= pendentes.length %></span><% } %>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= aba === 'agenda' ? 'active' : '' %>" type="button" role="tab"
              data-bs-toggle="pill" data-bs-target="#abaAgenda">Agenda</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= aba === 'registrar' ? 'active' : '' %>" type="button" role="tab"
              data-bs-toggle="pill" data-bs-target="#abaRegistrar">Registrar reunião</button>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade <%= aba === 'pendentes' ? 'show active' : '' %>" id="abaPendentes" role="tabpanel">
      <% if (pendentes.length === 0) { %>
        <%- include('partials/vazio', { texto: 'Nenhum pedido aguardando resposta.' }) %>
      <% } else { %>
        <div class="table-responsive mb-4">
          <table class="table table-hover align-middle bg-white shadow-sm mb-0">
            <thead>
              <tr>
                <th>Data e horário</th>
                <th>Cliente</th>
                <th>Assunto</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% pendentes.forEach(function (r) { %>
                <% const dataTexto = formatarData(r.inicio); %>
                <% const horaTexto = formatarHora(r.inicio); %>
                <% const resumo = dataTexto + ' às ' + horaTexto + ', com ' + r.cliente.nome; %>
                <tr>
                  <td>
                    <%= dataTexto %><br>
                    <small class="text-muted"><%= horaTexto %></small>
                  </td>
                  <td class="text-break"><%= r.cliente.nome %></td>
                  <td class="text-break">
                    <%= r.assunto %><br>
                    <small class="text-muted">
                      <%= r.tipo === 'PRESENCIAL' ? 'Presencial' : 'Online' %> · pedido em <%= formatarData(r.criadoEm) %>
                    </small>
                  </td>
                  <td>
                    <div class="d-flex flex-column flex-md-row gap-1 justify-content-md-end">
                      <button class="btn btn-sm btn-success confirmar-pedido" type="button"
                              data-id="<%= r.id %>" data-resumo="<%= resumo %>"
                              data-email="<%= r.cliente.email %>" data-telefone="<%= r.telefoneCliente %>">Confirmar</button>
                      <button class="btn btn-sm btn-outline-danger recusar-pedido" type="button"
                              data-id="<%= r.id %>" data-resumo="<%= resumo %>">Recusar</button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="tab-pane fade <%= aba === 'agenda' ? 'show active' : '' %>" id="abaAgenda" role="tabpanel">
      <%- include('partials/agenda') %>
    </div>

    <div class="tab-pane fade <%= aba === 'registrar' ? 'show active' : '' %>" id="abaRegistrar" role="tabpanel">
      <form method="post" action="/reunioes/registrar" class="card shadow-sm p-4">
        <p class="text-muted">Para reuniões pedidas por e-mail ou telefone. Elas já entram como confirmadas e ocupam o horário.</p>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="cliente">Cliente</label>
            <select class="form-select" id="cliente" name="cliente" required>
              <option value="">Escolha um cliente</option>
              <% clientes.forEach(function (c) { %>
                <option value="<%= c.id %>"><%= c.nome %> (<%= c.email %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="diaRegistro">Dia</label>
            <input class="form-control" type="date" id="diaRegistro" name="dia" min="<%= hoje %>" required>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="hora">Início</label>
            <select class="form-select" id="hora" name="hora" required>
              <% horasInicio.forEach(function (h) { %>
                <option value="<%= h %>"><%= String(h).padStart(2, '0') %>:00</option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="duracaoRegistro">Duração</label>
            <select class="form-select" id="duracaoRegistro" name="duracao" required>
              <option value="" selected disabled>Escolha a duração</option>
              <% duracoes.forEach(function (d) { %>
                <option value="<%= d.minutos %>"><%= d.rotulo %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="tipoRegistro">Tipo</label>
            <select class="form-select" id="tipoRegistro" name="tipo" required>
              <option value="ONLINE">Online</option>
              <option value="PRESENCIAL">Presencial</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="assuntoRegistro">Assunto</label>
            <input class="form-control" type="text" id="assuntoRegistro" name="assunto" maxlength="<%= assuntoMax %>" required>
          </div>
        </div>
        <div class="mt-3">
          <button class="btn btn-success" type="submit">Registrar reunião</button>
        </div>
      </form>
    </div>
  </div>
<% } else { %>
  <%- include('partials/agenda') %>
<% } %>

<div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="tituloCancelar" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="tituloCancelar">Cancelar reunião?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2" id="resumoCancelar"></p>
        <p class="small text-muted mb-0">O horário será liberado para outros pedidos.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
        <form method="post" id="formCancelar">
          <button type="submit" class="btn btn-danger">Cancelar reunião</button>
        </form>
      </div>
    </div>
  </div>
</div>

<% if (eSocio) { %>
  <div class="modal fade" id="modalConfirmarPedido" tabindex="-1" aria-labelledby="tituloConfirmarPedido" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="post" id="formConfirmarPedido">
          <input type="hidden" name="acao" value="confirmar">
          <div class="modal-header">
            <h2 class="modal-title h5" id="tituloConfirmarPedido">Confirmar pedido</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <p id="resumoConfirmarPedido" class="mb-2"></p>
            <dl class="row small mb-3">
              <dt class="col-sm-3">E-mail</dt>
              <dd class="col-sm-9 text-break"><a id="contatoEmail" href="#"></a></dd>
              <dt class="col-sm-3">Telefone</dt>
              <dd class="col-sm-9" id="contatoTelefone"></dd>
            </dl>
            <label class="form-label" for="duracaoConfirmar">Duração da reunião</label>
            <select class="form-select" id="duracaoConfirmar" name="duracao" required>
              <option value="" selected disabled>Escolha a duração</option>
              <% duracoes.forEach(function (d) { %>
                <option value="<%= d.minutos %>"><%= d.rotulo %></option>
              <% }); %>
            </select>
            <p class="small text-muted mt-2 mb-0">O máximo é 2 horas, e a reunião deve terminar até as 18h sem invadir outra reunião.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
            <button type="submit" class="btn btn-success">Confirmar pedido</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalRecusarPedido" tabindex="-1" aria-labelledby="tituloRecusarPedido" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form method="post" id="formRecusarPedido">
          <input type="hidden" name="acao" value="recusar">
          <div class="modal-header">
            <h2 class="modal-title h5" id="tituloRecusarPedido">Recusar pedido?</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body">
            <p class="mb-2" id="resumoRecusarPedido"></p>
            <p class="small text-muted mb-0">O horário será liberado e o cliente verá o pedido como recusado.</p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Voltar</button>
            <button type="submit" class="btn btn-danger">Recusar pedido</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function ligar(classeBotao, idModal, idForm, idResumo, caminho) {
      var elemento = document.getElementById(idModal);
      if (!elemento) return;
      var modal = new bootstrap.Modal(elemento);
      var form = document.getElementById(idForm);
      document.querySelectorAll('.' + classeBotao).forEach(function (botao) {
        botao.addEventListener('click', function () {
          form.action = '/reunioes/' + botao.dataset.id + '/' + caminho;
          document.getElementById(idResumo).textContent = botao.dataset.resumo;
          if (botao.dataset.email) {
            var email = document.getElementById('contatoEmail');
            email.textContent = botao.dataset.email;
            email.href = 'mailto:' + botao.dataset.email;
            document.getElementById('contatoTelefone').textContent = botao.dataset.telefone || 'Não informado';
          }
          var duracao = form.querySelector('select[name="duracao"]');
          if (duracao) duracao.selectedIndex = 0;
          modal.show();
        });
      });
    }

    ligar('cancelar', 'modalCancelar', 'formCancelar', 'resumoCancelar', 'cancelar');
    ligar('confirmar-pedido', 'modalConfirmarPedido', 'formConfirmarPedido', 'resumoConfirmarPedido', 'responder');
    ligar('recusar-pedido', 'modalRecusarPedido', 'formRecusarPedido', 'resumoRecusarPedido', 'responder');
  });
</script>

<%- include('partials/rodape') %>
