</main>
 
<footer class="rodape py-3">
  <div class="container text-center small">
    ECOT11A · Laboratório de Engenharia de Software
  </div>
</footer>
 
<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
  document.addEventListener('click', function (evento) {
    var botao = evento.target.closest('.mostrar-senha');
    if (!botao) return;
    var campo = document.getElementById(botao.dataset.alvo);
    var visivel = campo.type === 'password';
    campo.type = visivel ? 'text' : 'password';
    botao.setAttribute('aria-pressed', visivel);
    botao.setAttribute('aria-label', visivel ? 'Ocultar senha' : 'Mostrar senha');
    botao.querySelector('.olho').classList.toggle('d-none', visivel);
    botao.querySelector('.olho-cortado').classList.toggle('d-none', !visivel);
  });

  document.querySelectorAll('main > .alert, .caixa-login > .alert').forEach(function (aviso) {
    var espera = aviso.classList.contains('alert-danger') ? 8000 : 5000;
    setTimeout(function () {
      aviso.classList.add('saindo');
      setTimeout(function () { aviso.remove(); }, 400);
    }, espera);
  });

  document.addEventListener('hidden.bs.modal', function (evento) {
    evento.target.querySelectorAll('.mostrar-senha[aria-pressed="true"]').forEach(function (botao) { botao.click(); });
  });
</script>
</body>
</html>
 