<%- include('partials/topo', { titulo: titulo }) %>

<div class="caixa-login card shadow-sm p-4">
  <h1 class="h4 mb-3"><%= titulo %></h1>

  <% if (locals.erro) { %>
    <div class="alert alert-danger" role="alert"><%= erro %></div>
  <% } %>

  <form method="post" action="<%= acao %>">
    <%if (pedirCodigo) {%>
      <div class="mb-3">
        <label class="form-label d-block" for="codigo">Código de convite</label>
        <%- include('partials/campoSenha', { id: 'codigo', nome: 'codigo' }) %>
      </div>
    <% } %>
    <div class="mb-3">
      <label class="form-label" for="nome">Nome completo</label>
      <input class="form-control" type="text" id="nome" name="nome" value="<%= valores.nome || '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="email">E-mail</label>
      <input class="form-control" type="email" id="email" name="email" value="<%= valores.email || '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="cpf">CPF</label>
      <input class="form-control" type="text" id="cpf" name="cpf" value="<%= valores.cpf || '' %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label d-block" for="senha">Senha (mínimo 8 caracteres)</label>
      <%- include('partials/campoSenha', { id: 'senha', nome: 'senha', autocomplete: 'new-password' }) %>
    </div>
    <div class="mb-3">
      <label class="form-label d-block" for="confirmarSenha">Confirmar senha</label>
      <%- include('partials/campoSenha', { id: 'confirmarSenha', nome: 'confirmarSenha', autocomplete: 'new-password' }) %>
    </div>
    <button class="btn btn-success w-100" type="submit">Cadastrar</button>
  </form>

  <p class="text-center mt-3 mb-0">Já tem conta? <a href="/login">Entrar</a></p>
</div>

<%- include('partials/rodape') %>
