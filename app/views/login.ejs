<%- include('partials/topo', { titulo: 'Entrar' }) %>
<div class="caixa-login card shadow-sm p-4">
  <h1 class="h4 mb-3">Entrar</h1>
  <% if (locals.erro) { %>
  <div class="alert alert-danger" role="alert"><%= erro %></div>
  <% } %>
  <form method="post" action="/login">
    <div class="mb-3">
      <label for="email" class="form-label">E-mail</label>
      <input type="email" id="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label for="senha" class="form-label d-block">Senha</label>
      <%- include('partials/campoSenha', { id: 'senha', nome: 'senha', autocomplete: 'current-password' }) %>
    </div>
    <button class="btn btn-success w-100" type="submit">Entrar</button>
  </form>

  <p class="text-center mt-3 mb-0">Ainda não tem conta? <a href="/cadastro">Cadastre-se</a></p>
</div>

<%- include('partials/rodape') %>
