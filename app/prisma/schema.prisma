generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  CLIENTE
  SOCIO
}

enum TipoReuniao {
  ONLINE
  PRESENCIAL
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  RECUSADO
  CANCELADO
  EXPIRADO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  cpf       String?  @unique
  telefone  String?
  senhaHash String
  perfil    Perfil   @default(CLIENTE)
  criadoEm  DateTime @default(now())

  agendamentosComoCliente Agendamento[] @relation("DoCliente")
  agendamentosComoSocio   Agendamento[] @relation("DoSocio")
}

model Agendamento {
  id             Int               @id @default(autoincrement())
  inicio         DateTime
  duracaoMinutos Int?
  assunto        String
  status         StatusAgendamento @default(PENDENTE)
  criadoEm       DateTime          @default(now())
  tipo TipoReuniao @default(ONLINE)

  clienteId Int
  cliente   Usuario @relation("DoCliente", fields: [clienteId], references: [id])
  socioId   Int
  socio     Usuario @relation("DoSocio", fields: [socioId], references: [id])

  @@index([socioId, inicio]) //acelera a principal bsuca no bd pelas reunioes do sócio
}
