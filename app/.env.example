#Os valores 'senhaForte' são ilustrativos
#Troque todos antes de rodar, use um valor DIFERENTE para cada variável
#A única execeção é DATABASE_URL, que  ser igual a POSTGRES_PASSWORD
#Comando para gerar um valor aleatório: 
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


POSTGRES_USER=portal
POSTGRES_PASSWORD=senhaForte
POSTGRES_DB=portal
DATABASE_URL="postgresql://portal:senhaForte@localhost:5432/portal"

SESSION_SECRET=senhaForte

CODIGO_CONVITE_SOCIO=senhaForte